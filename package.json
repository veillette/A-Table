{
  "name": "a-table",
  "version": "1.0.0",
  "private": true,
  "description": "À Table recipe collection: a static site in dist/ with data checks and tests.",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-recipes.mjs",
    "thumbs": "node scripts/make-thumbs.mjs",
    "test:unit": "node --test tests/",
    "test:offline": "node --test tests/browser/offline.spec.mjs",
    "validate:html": "html-validate dist/index.html",
    "test": "npm run validate && npm run test:unit && npm run validate:html"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "html-validate": "^11.21.0",
    "playwright": "^1.65.0"
  },
  "engines": {
    "node": ">=26"
  }
}
